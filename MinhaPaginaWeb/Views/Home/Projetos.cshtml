@{
    ViewData["Title"] = "Projetos";
}
<h1>@ViewData["Title"]</h1>

<p>Use this page to detail your site's privacy policy.</p>

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .sidebar {
        background: #2c3e50;
        color: white;
        min-height: 100vh;
        padding: 2rem;
    }

    .profile-img {
        width: 150px;
        height: 150px;
        object-fit: cover;
        border: 4px solid #18bc9c;
    }

    .card {
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        margin-bottom: 1.5rem;
    }

    .badge-tech {
        background-color: #18bc9c;
        color: white;
        margin-right: 5px;
    }
</style>

<div id="app" class="container-fluid">
        <main class="col-md-9 p-5">
            <hr class="my-5">

            <section>
                <h3 class="mb-4">Experiência Profissional</h3>

                <div v-for="(exp, index) in experiencias" :key="index" class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5 class="card-title text-primary">{{ exp.funcao }}</h5>
                            <span class="text-muted">{{ exp.periodo }}</span>
                        </div>
                        <h6 class="card-subtitle mb-2 text-muted">{{ exp.empresa }}</h6>
                        <p class="card-text">{{ exp.descricao }}</p>
                    </div>
                </div>

                <div class="mt-5 p-4 border rounded bg-white">
                    <h5>Adicionar Experiência (Teste o Vue aqui)</h5>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <input v-model="novaExp.funcao" class="form-control" placeholder="Cargo">
                        </div>
                        <div class="col-md-4">
                            <input v-model="novaExp.empresa" class="form-control" placeholder="Empresa">
                        </div>
                        <div class="col-md-4">
                            <button @@click="adicionarExp" class="btn btn-success w-100">Adicionar à Lista</button>
                        </div>
                    </div>
                </div>
            </section>
        </main>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <script>
        const { createApp } = Vue

        createApp({
            data() {
                return {
                    nome: 'Gabriel Souza Noronha',
                    cargo: 'Desenvolvedor Full Stack',
                    email: 'gabrielnoronha02@gmail.com',
                    linkedin: 'https://www.linkedin.com/in/gabriel-noronha-67a9861b6/',
                    fotoUrl: 'https://media.licdn.com/dms/image/v2/D4D03AQEbrV05xJ_Chw/profile-displayphoto-scale_200_200/B4DZkq7fNwJMAY-/0/1757361863054?e=1776902400&v=beta&t=QBGP7pA_RAD7_gNjLK4ql_Gh-UYFEz6KVGOU0vVpZMg', // Coloque o link da sua foto real
                    sobre: 'Atualmente busco me realocar, migrando para área de Desenvolvimento, assim então podendo aplicar todo meu conhecimento em minha carreira. Atualmente além de projetos que realizo em minha graduação comecei a fazer freelancers.',
                    habilidades: ['C#', '.NET Core', 'Java', 'Python', 'AWS', 'Vue.js', 'SQL', 'Git'],

                    // Lista inicial de experiências
                    experiencias: [
                        {
                            funcao: 'Analista de T.I',
                            empresa: 'Telespazio Brasil',
                            periodo: 'jan de 2024 - Atualmente',
                            descricao: 'Atuando em desenvolvimento de automações, implementação/sustentação de sistemas, criação de monitoramentos, suporte de nível 2, etc.'
                        },
                        {
                            funcao: 'Estagiário de T.I',
                            empresa: 'Telespazio Brasil',
                            periodo: 'jan de 2022 - dez de 2023',
                            descricao: 'Atuação em suporte aos usuários, focado em nível 1, porém inicinando no nível 2.'
                        },
                        {
                            funcao: 'Estagiário de T.I',
                            empresa: 'Eversoft Ind.',
                            periodo: 'jun de 2021 - dez de 2022',
                            descricao: 'Atuação em suporte aos usuários, focado em nível 1.'
                        }
                    ],

                    // Objeto para o formulário de nova experiência
                    novaExp: { funcao: '', empresa: '', periodo: '2026', descricao: 'Nova experiência adicionada via Vue.' }
                }
            },
            methods: {
                adicionarExp() {
                    if (this.novaExp.funcao && this.novaExp.empresa) {
                        // Adiciona uma cópia do objeto à lista
                        this.experiencias.unshift({...this.novaExp});
                        // Limpa os campos
                        this.novaExp.funcao = '';
                        this.novaExp.empresa = '';
                    }
                }
            }
        }).mount('#app')
    </script>
}